# Backend URL reachable from the device/emulator (not "localhost" on a physical phone).
# Android emulator: http://10.0.2.2:8080   iOS simulator: http://localhost:8080   Device: http://<your-LAN-IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Optional Google sign-in (OAuth client IDs from Google Cloud Console; these are public identifiers, not secrets).
# Each must also be listed in the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
