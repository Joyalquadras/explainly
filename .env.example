# ---------------------------------------------------------------------------
# Explainly backend configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database (docker-compose sets DATABASE_URL automatically)
DATABASE_USERNAME=explainly
DATABASE_PASSWORD=change-me

# Security (REQUIRED in production)
# JWT_SECRET: at least 32 random characters.            e.g. openssl rand -base64 48
# TOKEN_ENCRYPTION_KEY: base64 of exactly 32 bytes.     e.g. openssl rand -base64 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# AI provider: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Optional AI extras (both use OPENAI_API_KEY)
AI_IMAGES_ENABLED=false
AUDIO_TRANSCRIPTION_ENABLED=false

# YouTube Data API key (optional; enables richer metadata such as duration and description)
YOUTUBE_API_KEY=

# Google sign-in: comma-separated OAuth client IDs accepted as ID-token audience.
# Put the WEB client ID first (the web app uses it); add the iOS/Android client IDs for the mobile app.
GOOGLE_CLIENT_IDS=

# YouTube account connection (server-side OAuth, Web application client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/youtube/oauth/callback

# Public URL of the web app (used for redirects after connecting YouTube)
APP_WEB_URL=http://localhost:8088
